        "field": "[Selected]",
        "formula": "[purchase_month] >= DATETRUNC('month', [Parameters].[StartMonth]) AND [purchase_month] <= DATETRUNC('month', [Parameters].[EndMonth]) AND ([Parameters].[BuyerState] = 'All' OR [buyer_state] = [Parameters].[BuyerState])"
