    "formula_manifest": [
      {
        "source": "Parameters",
        "field": "[StartMonth]",
        "formula": "#2017-02-01#"
      },
      {
        "source": "Parameters",
        "field": "[EndMonth]",
        "formula": "#2018-07-01#"
      },
      {
        "source": "Parameters",
        "field": "[BuyerState]",
        "formula": "\"All\""
      },
      {
        "source": "olist.orders",
        "field": "[Selected]",
        "formula": "[purchase_month] >= DATETRUNC('month', [Parameters].[StartMonth]) AND [purchase_month] <= DATETRUNC('month', [Parameters].[EndMonth]) AND ([Parameters].[BuyerState] = 'All' OR [buyer_state] = [Parameters].[BuyerState])"
      },
      {
        "source": "olist.orders",
        "field": "[Selected Sale]",
        "formula": "[Selected] AND [sales_eligible] = 1"
      },
      {
        "source": "olist.orders",
        "field": "[Selected Delivery]",
        "formula": "[Selected] AND [delivery_eligible] = 1"
      },
      {
        "source": "olist.orders",
        "field": "[Selected Orders]",
        "formula": "COUNTD(IF [Selected] THEN [order_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Sales Orders]",
        "formula": "COUNTD(IF [Selected Sale] THEN [order_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Sales Cents]",
        "formula": "SUM(IF [Selected Sale] THEN [product_value_cents] ELSE 0 END)"
      },
      {
        "source": "olist.orders",
        "field": "[Product Sales Value]",
        "formula": "[Sales Cents] / 100.0"
      },
      {
        "source": "olist.orders",
        "field": "[Average Order Value]",
        "formula": "IF [Sales Orders] > 0 THEN FLOOR((2 * [Sales Cents] + [Sales Orders]) / (2.0 * [Sales Orders])) / 100.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Delivery Orders]",
        "formula": "COUNTD(IF [Selected Delivery] THEN [order_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Late Orders]",
        "formula": "COUNTD(IF [Selected Delivery] AND [is_late] = 1 THEN [order_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Late Delivery Rate]",
        "formula": "IF [Delivery Orders] > 0 THEN FLOOR((20000 * [Late Orders] + [Delivery Orders]) / (2.0 * [Delivery Orders])) / 10000.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Delivery Seconds]",
        "formula": "SUM(IF [Selected Delivery] THEN [delivery_seconds] ELSE 0 END)"
      },
      {
        "source": "olist.orders",
        "field": "[Delivery Denominator]",
        "formula": "86400 * [Delivery Orders]"
      },
      {
        "source": "olist.orders",
        "field": "[Average Delivery Days]",
        "formula": "IF [Delivery Denominator] > 0 THEN FLOOR((200 * [Delivery Seconds] + [Delivery Denominator]) / (2.0 * [Delivery Denominator])) / 100.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Positive Delay Days]",
        "formula": "SUM(IF [Selected Delivery] AND [is_late] = 1 THEN [positive_delay_days] ELSE 0 END)"
      },
      {
        "source": "olist.orders",
        "field": "[Average Positive Delay]",
        "formula": "IF [Late Orders] > 0 THEN FLOOR((200 * [Positive Delay Days] + [Late Orders]) / (2.0 * [Late Orders])) / 100.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Selected Review]",
        "formula": "[Selected Sale] AND [review_eligible] = 1"
      },
      {
        "source": "olist.orders",
        "field": "[Reviewed Orders]",
        "formula": "COUNTD(IF [Selected Review] THEN [order_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Review Score Sum]",
        "formula": "SUM(IF [Selected Review] THEN [review_score] ELSE 0 END)"
      },
      {
        "source": "olist.orders",
        "field": "[Average Review Score]",
        "formula": "IF [Reviewed Orders] > 0 THEN FLOOR((200 * [Review Score Sum] + [Reviewed Orders]) / (2.0 * [Reviewed Orders])) / 100.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Review Coverage]",
        "formula": "IF [Sales Orders] > 0 THEN FLOOR((20000 * [Reviewed Orders] + [Sales Orders]) / (2.0 * [Sales Orders])) / 10000.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Low Score Orders]",
        "formula": "COUNTD(IF [Selected Review] AND [review_score] <= 2 THEN [order_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Low Score Rate]",
        "formula": "IF [Reviewed Orders] > 0 THEN FLOOR((20000 * [Low Score Orders] + [Reviewed Orders]) / (2.0 * [Reviewed Orders])) / 10000.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Pre Delivery Reviewed Orders]",
        "formula": "COUNTD(IF [Selected Review] AND [Selected Delivery] AND [review_before_delivery] = 1 THEN [order_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Customers]",
        "formula": "COUNTD(IF [Selected Sale] THEN [customer_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Customer Selected Orders]",
        "formula": "{ FIXED [customer_key] : COUNTD(IF [Selected Sale] THEN [order_key] END) }"
      },
      {
        "source": "olist.orders",
        "field": "[Repeat Customers]",
        "formula": "COUNTD(IF [Selected Sale] AND [Customer Selected Orders] >= 2 THEN [customer_key] END)"
      },
      {
        "source": "olist.orders",
        "field": "[Repeat Customer Rate]",
        "formula": "IF [Customers] > 0 THEN FLOOR((20000 * [Repeat Customers] + [Customers]) / (2.0 * [Customers])) / 10000.0 END"
      },
      {
        "source": "olist.orders",
        "field": "[Purchase Frequency]",
        "formula": "IF [Customer Selected Orders] = 1 THEN '1 order' ELSEIF [Customer Selected Orders] = 2 THEN '2 orders' ELSEIF [Customer Selected Orders] = 3 THEN '3 orders' ELSEIF [Customer Selected Orders] >= 4 THEN '4+ orders' END"
      },
      {
        "source": "olist.orders",
        "field": "[Review Bucket]",
        "formula": "IF [review_eligible] = 1 THEN STR([review_score]) ELSE 'No selected review' END"
      },
      {
