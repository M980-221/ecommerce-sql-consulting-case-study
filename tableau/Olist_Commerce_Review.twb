                <format attr="mark-color" value="#087f83" />
                <format attr="mark-labels-show" value="false" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[olist.orders].[usr:Average Review Score:qk]</rows>
        <cols>[olist.orders].[none:purchase_month:qk]</cols>
      </table>
