    <worksheet name="Sales | Product value by buyer state">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="12" fontcolor="#183449">Product value by buyer state</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="olist.orders" caption="Olist orders" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column name="[StartMonth]" caption="Start month" datatype="date" param-domain-type="list" role="measure" type="ordinal" value="#2017-02-01#">
              <calculation class="tableau" formula="#2017-02-01#" />
              <members>
                <member value="#2017-02-01#" alias="2017-02" />
                <member value="#2017-03-01#" alias="2017-03" />
                <member value="#2017-04-01#" alias="2017-04" />
                <member value="#2017-05-01#" alias="2017-05" />
                <member value="#2017-06-01#" alias="2017-06" />
                <member value="#2017-07-01#" alias="2017-07" />
                <member value="#2017-08-01#" alias="2017-08" />
                <member value="#2017-09-01#" alias="2017-09" />
                <member value="#2017-10-01#" alias="2017-10" />
                <member value="#2017-11-01#" alias="2017-11" />
                <member value="#2017-12-01#" alias="2017-12" />
                <member value="#2018-01-01#" alias="2018-01" />
                <member value="#2018-02-01#" alias="2018-02" />
                <member value="#2018-03-01#" alias="2018-03" />
                <member value="#2018-04-01#" alias="2018-04" />
                <member value="#2018-05-01#" alias="2018-05" />
                <member value="#2018-06-01#" alias="2018-06" />
                <member value="#2018-07-01#" alias="2018-07" />
              </members>
            </column>
            <column name="[EndMonth]" caption="End month" datatype="date" param-domain-type="list" role="measure" type="ordinal" value="#2018-07-01#">
              <calculation class="tableau" formula="#2018-07-01#" />
              <members>
                <member value="#2017-02-01#" alias="2017-02" />
                <member value="#2017-03-01#" alias="2017-03" />
                <member value="#2017-04-01#" alias="2017-04" />
                <member value="#2017-05-01#" alias="2017-05" />
                <member value="#2017-06-01#" alias="2017-06" />
                <member value="#2017-07-01#" alias="2017-07" />
                <member value="#2017-08-01#" alias="2017-08" />
                <member value="#2017-09-01#" alias="2017-09" />
                <member value="#2017-10-01#" alias="2017-10" />
                <member value="#2017-11-01#" alias="2017-11" />
                <member value="#2017-12-01#" alias="2017-12" />
                <member value="#2018-01-01#" alias="2018-01" />
                <member value="#2018-02-01#" alias="2018-02" />
                <member value="#2018-03-01#" alias="2018-03" />
                <member value="#2018-04-01#" alias="2018-04" />
                <member value="#2018-05-01#" alias="2018-05" />
                <member value="#2018-06-01#" alias="2018-06" />
                <member value="#2018-07-01#" alias="2018-07" />
              </members>
            </column>
            <column name="[BuyerState]" caption="Buyer state" datatype="string" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" alias="All" />
                <member value="&quot;AC&quot;" alias="AC" />
                <member value="&quot;AL&quot;" alias="AL" />
                <member value="&quot;AM&quot;" alias="AM" />
                <member value="&quot;AP&quot;" alias="AP" />
                <member value="&quot;BA&quot;" alias="BA" />
                <member value="&quot;CE&quot;" alias="CE" />
                <member value="&quot;DF&quot;" alias="DF" />
                <member value="&quot;ES&quot;" alias="ES" />
                <member value="&quot;GO&quot;" alias="GO" />
                <member value="&quot;MA&quot;" alias="MA" />
                <member value="&quot;MG&quot;" alias="MG" />
                <member value="&quot;MS&quot;" alias="MS" />
                <member value="&quot;MT&quot;" alias="MT" />
                <member value="&quot;PA&quot;" alias="PA" />
                <member value="&quot;PB&quot;" alias="PB" />
                <member value="&quot;PE&quot;" alias="PE" />
                <member value="&quot;PI&quot;" alias="PI" />
                <member value="&quot;PR&quot;" alias="PR" />
                <member value="&quot;RJ&quot;" alias="RJ" />
                <member value="&quot;RN&quot;" alias="RN" />
                <member value="&quot;RO&quot;" alias="RO" />
                <member value="&quot;RR&quot;" alias="RR" />
                <member value="&quot;RS&quot;" alias="RS" />
                <member value="&quot;SC&quot;" alias="SC" />
                <member value="&quot;SE&quot;" alias="SE" />
                <member value="&quot;SP&quot;" alias="SP" />
                <member value="&quot;TO&quot;" alias="TO" />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="olist.orders">
            <column name="[order_key]" datatype="integer" role="dimension" type="nominal" />
            <column name="[customer_key]" datatype="integer" role="dimension" type="nominal" />
            <column name="[purchase_month]" datatype="date" role="dimension" type="ordinal" />
            <column name="[buyer_state]" datatype="string" role="dimension" type="nominal" />
            <column name="[order_status]" datatype="string" role="dimension" type="nominal" />
            <column name="[sales_eligible]" datatype="integer" role="measure" type="quantitative" />
            <column name="[delivery_eligible]" datatype="integer" role="measure" type="quantitative" />
            <column name="[review_eligible]" datatype="integer" role="measure" type="quantitative" />
            <column name="[product_value_cents]" datatype="integer" role="measure" type="quantitative" />
            <column name="[delivery_seconds]" datatype="integer" role="measure" type="quantitative" />
            <column name="[is_late]" datatype="integer" role="measure" type="quantitative" />
            <column name="[positive_delay_days]" datatype="integer" role="measure" type="quantitative" />
            <column name="[review_score]" datatype="integer" role="measure" type="quantitative" />
            <column name="[review_before_delivery]" datatype="integer" role="measure" type="quantitative" />
            <column name="[Selected]" caption="Selected" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[purchase_month] &gt;= DATETRUNC('month', [Parameters].[StartMonth]) AND [purchase_month] &lt;= DATETRUNC('month', [Parameters].[EndMonth]) AND ([Parameters].[BuyerState] = 'All' OR [buyer_state] = [Parameters].[BuyerState])" />
            </column>
            <column name="[Selected Sale]" caption="Selected Sale" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Selected] AND [sales_eligible] = 1" />
            </column>
            <column name="[Selected Delivery]" caption="Selected Delivery" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Selected] AND [delivery_eligible] = 1" />
            </column>
            <column name="[Selected Orders]" caption="Selected Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected] THEN [order_key] END)" />
            </column>
            <column name="[Sales Orders]" caption="Sales Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Sale] THEN [order_key] END)" />
            </column>
            <column name="[Sales Cents]" caption="Sales Cents" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="SUM(IF [Selected Sale] THEN [product_value_cents] ELSE 0 END)" />
            </column>
            <column name="[Product Sales Value]" caption="Product Sales Value" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="[Sales Cents] / 100.0" />
            </column>
            <column name="[Average Order Value]" caption="Average Order Value" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="IF [Sales Orders] &gt; 0 THEN FLOOR((2 * [Sales Cents] + [Sales Orders]) / (2.0 * [Sales Orders])) / 100.0 END" />
            </column>
            <column name="[Delivery Orders]" caption="Delivery Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Delivery] THEN [order_key] END)" />
            </column>
            <column name="[Late Orders]" caption="Late Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Delivery] AND [is_late] = 1 THEN [order_key] END)" />
            </column>
            <column name="[Late Delivery Rate]" caption="Late Delivery Rate" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Delivery Orders] &gt; 0 THEN FLOOR((20000 * [Late Orders] + [Delivery Orders]) / (2.0 * [Delivery Orders])) / 10000.0 END" />
            </column>
            <column name="[Delivery Seconds]" caption="Delivery Seconds" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="SUM(IF [Selected Delivery] THEN [delivery_seconds] ELSE 0 END)" />
            </column>
            <column name="[Delivery Denominator]" caption="Delivery Denominator" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="86400 * [Delivery Orders]" />
            </column>
            <column name="[Average Delivery Days]" caption="Average Delivery Days" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="IF [Delivery Denominator] &gt; 0 THEN FLOOR((200 * [Delivery Seconds] + [Delivery Denominator]) / (2.0 * [Delivery Denominator])) / 100.0 END" />
            </column>
            <column name="[Positive Delay Days]" caption="Positive Delay Days" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="SUM(IF [Selected Delivery] AND [is_late] = 1 THEN [positive_delay_days] ELSE 0 END)" />
            </column>
            <column name="[Average Positive Delay]" caption="Average Positive Delay" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="IF [Late Orders] &gt; 0 THEN FLOOR((200 * [Positive Delay Days] + [Late Orders]) / (2.0 * [Late Orders])) / 100.0 END" />
            </column>
            <column name="[Selected Review]" caption="Selected Review" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Selected Sale] AND [review_eligible] = 1" />
            </column>
            <column name="[Reviewed Orders]" caption="Reviewed Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Review] THEN [order_key] END)" />
            </column>
            <column name="[Review Score Sum]" caption="Review Score Sum" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="SUM(IF [Selected Review] THEN [review_score] ELSE 0 END)" />
            </column>
            <column name="[Average Review Score]" caption="Average Review Score" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="IF [Reviewed Orders] &gt; 0 THEN FLOOR((200 * [Review Score Sum] + [Reviewed Orders]) / (2.0 * [Reviewed Orders])) / 100.0 END" />
            </column>
            <column name="[Review Coverage]" caption="Review Coverage" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Sales Orders] &gt; 0 THEN FLOOR((20000 * [Reviewed Orders] + [Sales Orders]) / (2.0 * [Sales Orders])) / 10000.0 END" />
            </column>
            <column name="[Low Score Orders]" caption="Low Score Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Review] AND [review_score] &lt;= 2 THEN [order_key] END)" />
            </column>
            <column name="[Low Score Rate]" caption="Low Score Rate" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Reviewed Orders] &gt; 0 THEN FLOOR((20000 * [Low Score Orders] + [Reviewed Orders]) / (2.0 * [Reviewed Orders])) / 10000.0 END" />
            </column>
            <column name="[Pre Delivery Reviewed Orders]" caption="Pre Delivery Reviewed Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Review] AND [Selected Delivery] AND [review_before_delivery] = 1 THEN [order_key] END)" />
            </column>
            <column name="[Customers]" caption="Customers" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Sale] THEN [customer_key] END)" />
            </column>
            <column name="[Customer Selected Orders]" caption="Customer Selected Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="{ FIXED [customer_key] : COUNTD(IF [Selected Sale] THEN [order_key] END) }" />
            </column>
            <column name="[Repeat Customers]" caption="Repeat Customers" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Sale] AND [Customer Selected Orders] &gt;= 2 THEN [customer_key] END)" />
            </column>
            <column name="[Repeat Customer Rate]" caption="Repeat Customer Rate" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Customers] &gt; 0 THEN FLOOR((20000 * [Repeat Customers] + [Customers]) / (2.0 * [Customers])) / 10000.0 END" />
            </column>
            <column name="[Purchase Frequency]" caption="Purchase Frequency" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [Customer Selected Orders] = 1 THEN '1 order' ELSEIF [Customer Selected Orders] = 2 THEN '2 orders' ELSEIF [Customer Selected Orders] = 3 THEN '3 orders' ELSEIF [Customer Selected Orders] &gt;= 4 THEN '4+ orders' END" />
            </column>
            <column name="[Review Bucket]" caption="Review Bucket" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [review_eligible] = 1 THEN STR([review_score]) ELSE 'No selected review' END" />
            </column>
            <column-instance column="[Product Sales Value]" derivation="User" name="[usr:Product Sales Value:qk]" pivot="key" type="quantitative" />
            <column-instance column="[buyer_state]" derivation="None" name="[none:buyer_state:nk]" pivot="key" type="nominal" />
            <column-instance column="[Selected]" derivation="None" name="[none:Selected:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[olist.orders].[none:Selected:nk]">
            <groupfilter function="member" level="[none:Selected:nk]" member="true" />
          </filter>
          <computed-sort column="[olist.orders].[none:buyer_state:nk]" direction="DESC" using="[olist.orders].[usr:Product Sales Value:qk]" />
          <slices>
            <column>[olist.orders].[none:Selected:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
          </style-rule>
          <style-rule element="table">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
            <format attr="color" value="#183449" />
            <format attr="background-color" value="#ffffff" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#087f83" />
                <format attr="mark-labels-show" value="false" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[olist.orders].[none:buyer_state:nk]</rows>
        <cols>[olist.orders].[usr:Product Sales Value:qk]</cols>
      </table>
      <simple-id uuid="{1350862C-785D-56CA-A094-025D6E01304A}" />
    </worksheet>
