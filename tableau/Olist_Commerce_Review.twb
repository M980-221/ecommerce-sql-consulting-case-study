            </column>
            <column name="[Late Delivery Rate]" caption="Late Delivery Rate" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Delivery Orders] &gt; 0 THEN FLOOR((20000 * [Late Orders] + [Delivery Orders]) / (2.0 * [Delivery Orders])) / 10000.0 END" />
            </column>
            <column name="[Delivery Seconds]" caption="Delivery Seconds" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="SUM(IF [Selected Delivery] THEN [delivery_seconds] ELSE 0 END)" />
            </column>
            <column name="[Delivery Denominator]" caption="Delivery Denominator" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="86400 * [Delivery Orders]" />
            </column>
            <column name="[Average Delivery Days]" caption="Average Delivery Days" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="IF [Delivery Denominator] &gt; 0 THEN FLOOR((200 * [Delivery Seconds] + [Delivery Denominator]) / (2.0 * [Delivery Denominator])) / 100.0 END" />
            </column>
            <column name="[Positive Delay Days]" caption="Positive Delay Days" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="SUM(IF [Selected Delivery] AND [is_late] = 1 THEN [positive_delay_days] ELSE 0 END)" />
            </column>
            <column name="[Average Positive Delay]" caption="Average Positive Delay" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="IF [Late Orders] &gt; 0 THEN FLOOR((200 * [Positive Delay Days] + [Late Orders]) / (2.0 * [Late Orders])) / 100.0 END" />
            </column>
            <column name="[Selected Review]" caption="Selected Review" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Selected Sale] AND [review_eligible] = 1" />
            </column>
            <column name="[Reviewed Orders]" caption="Reviewed Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Review] THEN [order_key] END)" />
            </column>
            <column name="[Review Score Sum]" caption="Review Score Sum" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="SUM(IF [Selected Review] THEN [review_score] ELSE 0 END)" />
            </column>
            <column name="[Average Review Score]" caption="Average Review Score" datatype="real" role="measure" type="quantitative" default-format="n2">
              <calculation class="tableau" formula="IF [Reviewed Orders] &gt; 0 THEN FLOOR((200 * [Review Score Sum] + [Reviewed Orders]) / (2.0 * [Reviewed Orders])) / 100.0 END" />
            </column>
            <column name="[Review Coverage]" caption="Review Coverage" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Sales Orders] &gt; 0 THEN FLOOR((20000 * [Reviewed Orders] + [Sales Orders]) / (2.0 * [Sales Orders])) / 10000.0 END" />
            </column>
            <column name="[Low Score Orders]" caption="Low Score Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Review] AND [review_score] &lt;= 2 THEN [order_key] END)" />
            </column>
            <column name="[Low Score Rate]" caption="Low Score Rate" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Reviewed Orders] &gt; 0 THEN FLOOR((20000 * [Low Score Orders] + [Reviewed Orders]) / (2.0 * [Reviewed Orders])) / 10000.0 END" />
            </column>
            <column name="[Pre Delivery Reviewed Orders]" caption="Pre Delivery Reviewed Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Review] AND [Selected Delivery] AND [review_before_delivery] = 1 THEN [order_key] END)" />
            </column>
            <column name="[Customers]" caption="Customers" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Sale] THEN [customer_key] END)" />
            </column>
            <column name="[Customer Selected Orders]" caption="Customer Selected Orders" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="{ FIXED [customer_key] : COUNTD(IF [Selected Sale] THEN [order_key] END) }" />
            </column>
            <column name="[Repeat Customers]" caption="Repeat Customers" datatype="integer" role="measure" type="quantitative" default-format="n0">
              <calculation class="tableau" formula="COUNTD(IF [Selected Sale] AND [Customer Selected Orders] &gt;= 2 THEN [customer_key] END)" />
            </column>
            <column name="[Repeat Customer Rate]" caption="Repeat Customer Rate" datatype="real" role="measure" type="quantitative" default-format="p2">
              <calculation class="tableau" formula="IF [Customers] &gt; 0 THEN FLOOR((20000 * [Repeat Customers] + [Customers]) / (2.0 * [Customers])) / 10000.0 END" />
            </column>
            <column name="[Purchase Frequency]" caption="Purchase Frequency" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [Customer Selected Orders] = 1 THEN '1 order' ELSEIF [Customer Selected Orders] = 2 THEN '2 orders' ELSEIF [Customer Selected Orders] = 3 THEN '3 orders' ELSEIF [Customer Selected Orders] &gt;= 4 THEN '4+ orders' END" />
            </column>
            <column name="[Review Bucket]" caption="Review Bucket" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [review_eligible] = 1 THEN STR([review_score]) ELSE 'No selected review' END" />
            </column>
            <column-instance column="[Average Review Score]" derivation="User" name="[usr:Average Review Score:qk]" pivot="key" type="quantitative" />
            <column-instance column="[purchase_month]" derivation="None" name="[none:purchase_month:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Reviewed Orders]" derivation="User" name="[usr:Reviewed Orders:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Selected]" derivation="None" name="[none:Selected:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[olist.orders].[none:Selected:nk]">
            <groupfilter function="member" level="[none:Selected:nk]" member="true" />
          </filter>
          <slices>
            <column>[olist.orders].[none:Selected:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
          </style-rule>
          <style-rule element="table">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
            <format attr="color" value="#183449" />
            <format attr="background-color" value="#ffffff" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <tooltip column="[olist.orders].[usr:Reviewed Orders:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true">&lt;[olist.orders].[none:purchase_month:qk]&gt;
</run>
                <run>Average Review Score: &lt;[olist.orders].[usr:Average Review Score:qk]&gt;
</run>
                <run>Reviewed Orders: &lt;[olist.orders].[usr:Reviewed Orders:qk]&gt;
</run>
              </formatted-text>
            </customized-tooltip>
