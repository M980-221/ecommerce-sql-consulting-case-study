          <datasource-dependencies datasource="Parameters">
            <column name="[StartMonth]" caption="Start month" datatype="date" param-domain-type="list" role="measure" type="ordinal" value="#2017-02-01#">
              <calculation class="tableau" formula="#2017-02-01#" />
              <members>
