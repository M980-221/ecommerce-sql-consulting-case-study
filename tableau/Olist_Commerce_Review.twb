          <formatted-text>
            <run bold="true" fontsize="12" fontcolor="#183449">Late delivery rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="olist.orders" caption="Olist orders" />
