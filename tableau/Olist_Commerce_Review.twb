            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Automatic" />
            <encodings>
              <text column="[olist.orders].[usr:Late Orders:qk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontsize="10" fontcolor="#183449">LATE ORDERS
</run>
                <run bold="true" fontsize="26" fontcolor="#087f83">&lt;[olist.orders].[usr:Late Orders:qk]&gt;</run>
                <run fontsize="9" fontcolor="#bb6845">
After the promised calendar day</run>
              </formatted-text>
            </customized-label>
