                <member value="&quot;CE&quot;" alias="CE" />
                <member value="&quot;DF&quot;" alias="DF" />
                <member value="&quot;ES&quot;" alias="ES" />
                <member value="&quot;GO&quot;" alias="GO" />
                <member value="&quot;MA&quot;" alias="MA" />
                <member value="&quot;MG&quot;" alias="MG" />
                <member value="&quot;MS&quot;" alias="MS" />
                <member value="&quot;MT&quot;" alias="MT" />
                <member value="&quot;PA&quot;" alias="PA" />
                <member value="&quot;PB&quot;" alias="PB" />
                <member value="&quot;PE&quot;" alias="PE" />
                <member value="&quot;PI&quot;" alias="PI" />
